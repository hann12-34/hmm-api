PORT=3001

# MongoDB Atlas URI dedicated to Home Micro Maintenance
# Do NOT reuse another project's DB/account!
#
# How to get it from Atlas:
# 1. Sign in at https://cloud.mongodb.com
# 2. Select the HMM cluster (or create a new one)
# 3. Connect -> Drivers -> copy the connection string
# 4. Replace <password> with the real password
# 5. Set the DB name to hmm_maintenance (do not touch existing DB names)
#
# Example format:
# MONGODB_URI=mongodb+srv://HMM_USER:HMM_PASSWORD@cluster.xxxxx.mongodb.net/hmm_maintenance?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/hmm_maintenance?retryWrites=true&w=majority
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGIN=*

# In-app notifications are stored in MongoDB — no extra env vars required.
